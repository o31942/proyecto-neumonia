# ==============================================================================
# Git Ignore - Proyecto Neumonía (UAO - Gestión de Proyectos en IA y CD)
# ==============================================================================

# Entornos virtuales y dependencias (uv / venv)
.venv/
env/
venv/
ENV/
build/
dist/
*.egg-info/

# Byte-compiled / cachés de Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Caché de herramientas de testing y linting
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.mypy_cache/

# REGLA ESTRICTA DE CURSO: Prohibido versionar pesos de modelos binarios pesados
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.bin
*.pkl
*.joblib
!models/.gitkeep

# REGLA DE CURSO: Prohibido subir notebooks sucios a repositorios modulares
*.ipynb
.ipynb_checkpoints/

# Variables de entorno y secretos
.env
.env.*
!.env.example

# Archivos de sistema operativo y editores
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*~
